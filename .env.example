# Copy to .env.local and fill in real values. Never commit .env.local.
# See LP-QARVON-SPEC.md section 17 for which of these are still pending.

# --- Cal.com ---
# Not used as the automatic post-submit redirect (that now goes to /obrigado
# — scheduling is manual, after a human reviews the lead). Still computed
# and logged per lead in the Sheets row (cal_redirect_url) so the link is
# ready to send manually. Real booking-page URL for the event type, public
# prefill via ?name= supported natively by Cal.com — see lib/calcom.ts.
CALCOM_BOOKING_URL=

# --- Qarvon OS (CRM) — server-side only, never exposed to the client ---
# Fonte de verdade da submissão: POST /api/leads chama
# POST <QARVON_OS_API_URL>/api/integrations/leads server-to-server antes de
# qualquer outra persistência (ver lib/qarvonOsLeadBackend.ts). Falha aqui é
# erro para o visitante — não redireciona para /obrigado.
#
# Origem da instância Qarvon OS (sem path — "/api/integrations/leads" é
# concatenado pelo código). Ex.: https://crm.qarvon.com.br
QARVON_OS_API_URL=
# Token de integração em texto puro, gerado e entregue pelo administrador do
# Qarvon OS (ver qarvon-os/supabase/BOOTSTRAP.md, seção "Procedimento para
# provisionar uma credencial de integração"). Nunca com prefixo NEXT_PUBLIC_,
# nunca hardcoded no código, nunca logado.
QARVON_OS_INTEGRATION_TOKEN=

# --- Google Sheets (server-side only, never exposed to the client) ---
# Secundário/best-effort desde a integração com o Qarvon OS: uma falha aqui
# nunca impede o sucesso da submissão nem é equivalente a "lead criado no
# CRM" — só um registro auxiliar em paralelo.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private key with literal \n for line breaks (as exported by GCP).
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB_NAME=Leads

# --- Webhooks ---
# Comma-separated list of endpoints to notify on every valid lead.
WEBHOOK_URLS=
# Optional: if set, each request carries an X-Qarvon-Signature HMAC-SHA256
# header over the raw JSON body, so receivers can verify authenticity.
WEBHOOK_SECRET=

# --- Meta Ads ---
NEXT_PUBLIC_META_PIXEL_ID=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://qarvon.com.br

# --- Video assets (optional; sections hide themselves in production until set) ---
NEXT_PUBLIC_CASE_VIDEO_URL=
NEXT_PUBLIC_VSL_URL=
